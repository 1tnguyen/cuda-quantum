// RUN: cudaq-opt --pass-pipeline="builtin.module(hw-jit-prep-pipeline{no-loop-unroll=true defer-unwind-lowering=true})" %s | FileCheck %s
// RUN: cudaq-opt --pass-pipeline="builtin.module(aot-prep-pipeline{gen-run-stack=false defer-unwind-lowering=true})" %s | FileCheck %s

func.func @unwind_return(%condition : i1) -> i64 {
  %c0 = arith.constant 0 : i64
  %c1 = arith.constant 1 : i64
  %true = arith.constant true
  cc.loop while {
    cc.condition %true
  } do {
    cc.if(%condition) {
      cc.unwind_return %c1 : i64
    }
    cc.continue
  }
  return %c0 : i64
}

// CHECK-LABEL: func.func @unwind_return
// CHECK:         cc.loop while
// CHECK:           cc.if
// CHECK:             cc.unwind_return
