  quake.sink %q51 : !quake.wire
  quake.sink %q52 : !quake.wire
  quake.sink %q53 : !quake.wire
  quake.sink %q54 : !quake.wire
  quake.sink %q55 : !quake.wire
  quake.sink %q56 : !quake.wire
  quake.sink %q57 : !quake.wire
  quake.sink %q58 : !quake.wire
  quake.sink %q59 : !quake.wire
  quake.sink %q60 : !quake.wire
  quake.sink %q61 : !quake.wire
  quake.sink %q62 : !quake.wire
  quake.sink %q63 : !quake.wire
  quake.sink %q64 : !quake.wire
  return
}

// CHECK-LABEL: func.func @wide
// CHECK-COUNT-65: quake.sink
// CHECK: return
