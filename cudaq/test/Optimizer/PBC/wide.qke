  quake.sink %q35 : !quake.wire
  quake.sink %q36 : !quake.wire
  quake.sink %q37 : !quake.wire
  quake.sink %q38 : !quake.wire
  quake.sink %q39 : !quake.wire
  quake.sink %q40 : !quake.wire
  quake.sink %q41 : !quake.wire
  quake.sink %q42 : !quake.wire
  quake.sink %q43 : !quake.wire
  quake.sink %q44 : !quake.wire
  quake.sink %q45 : !quake.wire
  quake.sink %q46 : !quake.wire
  quake.sink %q47 : !quake.wire
  quake.sink %q48 : !quake.wire
