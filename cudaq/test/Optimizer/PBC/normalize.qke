//===----------------------------------------------------------------------===//
/// \file
/// \brief Conversion of supported scalar-wire circuits into verified PBC.
///
/// Checks Clifford-frame absorption, terminal observables, and the subsequent
/// lowering path. The optimizer must reject mixed-form input without
/// conversion.
//===----------------------------------------------------------------------===//

// RUN: cudaq-opt %s --quake-to-pbc='semantics=release' --quake-verify-pbc | FileCheck %s
// RUN: cudaq-opt %s --quake-to-pbc='semantics=release' --quake-optimize-pbc='semantics=release' --quake-verify-pbc --quake-lower-pbc | FileCheck %s --check-prefix=LOWER
// RUN: not cudaq-opt %s --quake-optimize-pbc='semantics=release' 2>&1 | FileCheck %s --check-prefix=REJECT

func.func @frame(%a: !quake.wire, %b: !quake.wire) -> (!quake.measure, !quake.measure) {
  %c:2 = quake.x [%a] %b : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %t = quake.t %c#1 : (!quake.wire) -> !quake.wire
  %m0, %q0 = quake.mx %c#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %m1, %q1 = quake.mx %t : (!quake.wire) -> (!quake.measure, !quake.wire)
  quake.sink %q0 : !quake.wire
  quake.sink %q1 : !quake.wire
  return %m0, %m1 : !quake.measure, !quake.measure
}
// CHECK-LABEL: func.func @frame
// CHECK: quake.exp_pauli
// CHECK-SAME: to "ZZ"
// CHECK-SAME: quake.pbc_angle = array<i64: -1, 8>
// CHECK: quake.mpp
// CHECK-SAME: to "XX"
// CHECK: quake.mpp
// CHECK-SAME: to "X"
// LOWER-LABEL: func.func @frame
// LOWER-NOT: quake.exp_pauli
// LOWER: quake.t
// LOWER-NOT: quake.mpp
// LOWER: quake.mz
// LOWER: quake.mz
// REJECT: PBC form permits only quake.exp_pauli unitary operations

func.func @dynamic(%a: !quake.wire, %theta: f64) -> !quake.measure {
  %h = quake.h %a : (!quake.wire) -> !quake.wire
  %r = quake.rz (%theta) %h : (f64, !quake.wire) -> !quake.wire
  %m, %q = quake.mz %r : (!quake.wire) -> (!quake.measure, !quake.wire)
  quake.sink %q : !quake.wire
  return %m : !quake.measure
}
// CHECK-LABEL: func.func @dynamic
// CHECK: arith.mulf
// CHECK: quake.exp_pauli
// CHECK-SAME: to "X"
// CHECK-NOT: quake.pbc_angle
// CHECK: quake.mpp
// CHECK-SAME: to "X"
